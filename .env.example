# Copy to .env and fill in. Used by docker compose.

# Public address of the web container (the payment page and dashboard).
PUBLIC_URL=http://localhost:5180
CORS_ORIGINS=["http://localhost:5180"]
# Domain that TON Connect proofs are issued for, host and port of PUBLIC_URL.
TON_PROOF_DOMAIN=localhost:5180

# Long random string, for example: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_PASSWORD=checkout

TON_NETWORK=testnet
TON_PROVIDER=toncenter
# Optional. Without a key toncenter allows about 1 request per second.
TONCENTER_API_KEY=
TONAPI_API_KEY=

# Master contract of the jetton accepted as USDT. On testnet, deploy one with backend/tools/testnet.py.
USDT_JETTON_MASTER=
# Wallet of the demo store (testnet, non-bounceable 0Q... form).
DEMO_WALLET_ADDRESS=

# Optional Telegram bot for Stars payments and the Mini App button.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_TEST_ENV=false
# Stars demo: the Stars button runs the simulator and nothing is charged. Set to false to sell
# for real Stars (needs the bot token).
STARS_DEMO=true
# Long polling takes all updates of the bot. Leave off for a bot shared with other projects.
TELEGRAM_BOT_POLLING=false
# For real Stars on a public demo: refund right after the order is fulfilled.
STARS_AUTO_REFUND=true

# Speeds up webhook retries in a demo (60 = one minute instead of one hour).
WEBHOOK_RETRY_SPEEDUP=1
