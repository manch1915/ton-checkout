# Local development: API and worker run on the host, Postgres and Redis in docker compose.
ENV=dev
DATABASE_URL=postgresql+asyncpg://checkout:checkout@127.0.0.1:5452/checkout
REDIS_URL=redis://127.0.0.1:6395/0
PUBLIC_URL=http://localhost:5180
CORS_ORIGINS=["http://localhost:5180"]
SHOP_WEBHOOK_URL=http://localhost:8010/api/shop/webhook
TON_PROOF_DOMAIN=localhost:5180
DEMO_WALLET_ADDRESS=
USDT_JETTON_MASTER=
TELEGRAM_BOT_TOKEN=
WEBHOOK_RETRY_SPEEDUP=60
